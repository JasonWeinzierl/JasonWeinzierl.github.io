{
  "cSpell.words": [
    "Belton",
    "Kanban",
    "Mizzou",
    "SSIS",
    "weavix",
    "Weinzierl"
  ],
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "tailwindCSS.includeLanguages": {
    "astro": "html",
  },
  "[opentofu][opentofu-vars]": {
    "editor.defaultFormatter": "opentofu.vscode-opentofu",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.formatAll.opentofu": "explicit",
    },
  },
}
