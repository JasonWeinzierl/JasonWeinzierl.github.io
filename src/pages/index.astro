---
import { Image } from 'astro:assets';

import linkedinLogo from '../assets/InBug-White.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="en-US">
<head>
    <BaseHead title="Jason Weinzierl" />
</head>

<body>
    <Header />
    <main>
        <div class="container mx-auto mt-6 px-3">
            <h1 class="h0 mb-2 font-light">Jason Weinzierl</h1>
            <p class="mb-4 text-xl font-light">
                <a href="/Experience/" class="text-gray-600 underline">Software Engineer. </a>
                <a href="/Education/" class="text-gray-600 underline">Mizzou Graduate. </a>
                <a href="/Interests/" class="text-gray-600 underline">Volunteer contributor.</a>
            </p>
            <p class="mb-4">
                <a
                    href="https://www.linkedin.com/in/jasonweinzierl"
                    class="cursor-pointer rounded-md bg-sky-600 px-3.5 py-2 text-white transition-colors duration-200 hover:bg-sky-700 focus:bg-sky-700 focus:ring-4 focus:ring-sky-300 focus:outline-none active:bg-sky-300"
                >
                    <Image src={linkedinLogo} alt="" width={24} densities={[1, 2]} class="inline size-6 object-contain pb-1" />
                    Jason Weinzierl on LinkedIn
                </a>
            </p>
        </div>
    </main>
    <Footer />
</body>
</html>
